# Скопируйте этот файл как keystore.properties в эту же папку (src-tauri/gen/android/keystore.properties)
#
# Создать новый ключ можно командой:
# keytool -genkey -v -keystore release.keystore -alias mashiro -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.keystore
storePassword=your_store_password
keyAlias=mashiro
keyPassword=your_key_password
